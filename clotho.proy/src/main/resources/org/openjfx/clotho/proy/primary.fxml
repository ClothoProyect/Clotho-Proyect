<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
	prefHeight="768.0" prefWidth="1024.0" 
	stylesheets="@estilo.css" styleClass="panel-principal"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="org.openjfx.clotho.proy.PrimaryController">
   <top>
      <VBox prefHeight="100.0" prefWidth="1024.0" BorderPane.alignment="CENTER">
         <children>
            <ToolBar prefHeight="40.0" prefWidth="200.0">
              <items>
                <Button mnemonicParsing="false" text="Buscar Ticket" 
                onAction="#abrirVentanaPedidos" styleClass="boton-clotho"/>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" 
        		text="Añadir Cliente" onAction="#abrirVentanaNuevoCliente" styleClass="boton-clotho" />
                <Button mnemonicParsing="false" text="Salir" />
              </items>
            </ToolBar>
            <GridPane hgap="10.0" prefHeight="60.0" vgap="5.0">
              <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                  <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                  <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="50.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Cliente:" />
                  <javafx.scene.control.ComboBox fx:id="cmbCliente" editable="true" GridPane.columnIndex="1" />
                  <Label text="Fecha" GridPane.columnIndex="2" />
                  <DatePicker fx:id="fechaPedido" GridPane.columnIndex="3" />
               </children>
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </GridPane>
         </children>
      </VBox>
   </top>
	<center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="tablaServicios" prefHeight="480.0" prefWidth="200.0" BorderPane.alignment="CENTER"
      styleClass="tabla-clotho">
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
    <columns>
        <TableColumn text="Servicio">
            <cellValueFactory>
                <PropertyValueFactory property="nombre" />
            </cellValueFactory>
        </TableColumn>
        
        <TableColumn text="Precio">
            <cellValueFactory>
                <PropertyValueFactory property="precio" />
            </cellValueFactory>
        </TableColumn>
        
        <TableColumn text="Descripción">
            <cellValueFactory>
                <PropertyValueFactory property="descripcion" />
            </cellValueFactory>
        </TableColumn>
        
        </columns>
	</TableView>
            <GridPane fx:id="gridResumenSemana" gridLinesVisible="true" HBox.hgrow="ALWAYS">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="12.5" halignment="CENTER" />
                        <ColumnConstraints percentWidth="12.5" halignment="CENTER" />
                        <ColumnConstraints percentWidth="12.5" halignment="CENTER" />
                        <ColumnConstraints percentWidth="12.5" halignment="CENTER" />
                        <ColumnConstraints percentWidth="12.5" halignment="CENTER" />
                        <ColumnConstraints percentWidth="12.5" halignment="CENTER" />
                        <ColumnConstraints percentWidth="12.5" halignment="CENTER" />
                        <ColumnConstraints percentWidth="12.5" halignment="CENTER" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="20.0" prefHeight="25.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="20.0" prefHeight="25.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="20.0" prefHeight="25.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="20.0" prefHeight="25.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label text="Pedidos"  GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label text="Prendas"  GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        
                        <Label fx:id="primerDia" styleClass="cabecera-dia" onMouseClicked="#manejarDobleClickDia"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label fx:id="primerDiaFecha" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label fx:id="primerDiaPedidos" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label fx:id="primerDiaPrendas" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label fx:id="segundoDia" styleClass="cabecera-dia-hoy" onMouseClicked="#manejarDobleClickDia"
                        GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="18/04/2026" styleClass="fondo-hoy" maxWidth="Infinity" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <Label text="9" styleClass="fondo-hoy" maxWidth="Infinity" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <Label text="11" styleClass="fondo-hoy" maxWidth="Infinity" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="3"/>

                        </children>
                  </GridPane>
         </children>
      </VBox>
   </center>
   <right>
      <VBox prefHeight="200.0" prefWidth="200.0" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    text="Añadir Arreglo" onAction="#abrirVentanaServicios" styleClass="boton-clotho" />
			<CheckBox fx:id="chkTarjeta" text="Tarjeta" styleClass="check-clotho"/>
            <Button fx:id="btnFinalizarPedido" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    text="Finalizar Pedido" onAction="#procesarPedido" styleClass="boton-clotho"/>
            <Region VBox.vgrow="ALWAYS" />
            <GridPane hgap="5.0" vgap="5.0">
               <children>
                  <Label text="Arreglos de hoy: "  GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                  <Label fx:id="txtNombre" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
               </children>
            </GridPane>
         </children>
      </VBox>
   </right>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="100.0" prefWidth="180.0">
               <children>
                  <ImageView fitHeight="60.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@zyp_logo.png" /> </image>
                  </ImageView>
                  <Label text="Clotho" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" text="Cancelar" 
            onAction="#handleCancelar" styleClass="boton-clotho"/>
            <Button mnemonicParsing="false" text="A Pagar" 
            onAction="#handleAPagar" styleClass="boton-clotho"/>
            <Button mnemonicParsing="false" text="Pagado" 
            onAction="#handlePagado" styleClass="boton-clotho"/>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>