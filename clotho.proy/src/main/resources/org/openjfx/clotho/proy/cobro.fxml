<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" prefWidth="450.0" prefHeight="200.0"
      stylesheets="@estilo.css" styleClass="panel-principal"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.openjfx.clotho.proy.CobroController">
      
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Este ticket no ha sido pagado."/>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Cantidad a cobrar:"/>
        <Label fx:id="lblImporte" text="0.00 €"/>
    </HBox>

    <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
        <Button text="Cancelar" onAction="#cancelar" prefWidth="130.0" styleClass="boton-clotho"/>
        <Button text="Cobrar y Retirar" onAction="#confirmar" prefWidth="240.0" styleClass="boton-clotho-rojo"/>
    </HBox>
</VBox>