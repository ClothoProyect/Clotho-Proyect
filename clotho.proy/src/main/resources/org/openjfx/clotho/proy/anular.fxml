<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" prefWidth="400.0" prefHeight="250.0"
      stylesheets="@estilo.css" styleClass="panel-principal"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.openjfx.clotho.proy.AnularController">
      
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="ADVERTENCIA"/>
    
    <Label text="¿Está seguro de que desea anular este ticket? Al hacerlo, se dará de baja y no contará para ningún tipo de cálculo de ingresos o estadísticas." 
           wrapText="true" textAlignment="CENTER" minHeight="-Infinity"/>

    <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
        <Button text="Volver" onAction="#cancelar" prefWidth="120.0" styleClass="boton-clotho"/>
        <Button text="Anular Ticket" onAction="#confirmar" styleClass="boton-clotho-rojo" prefWidth="150.0"/>
    </HBox>
</VBox>